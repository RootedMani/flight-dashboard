# Virtual environment (each person creates their own with pip install)
.venv/

# Python's compiled cache files
__pycache__/
*.pyc

# The raw CSV is too big for git (43 MB) and is never changed.
data/*.csv

# Parquet files are ignored too, EXCEPT the cleaned data (11 MB): it is
# included so the dashboard runs right after cloning, without the raw CSV.
data/*.parquet
!data/clean_flights.parquet
